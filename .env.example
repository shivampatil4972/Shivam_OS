# All variables are optional. The site works fully without them.

# Canonical origin used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://shivam-os.vercel.app

# Contact form delivery. Leave both unset and the form explains that delivery
# is not configured and offers the email address instead.
# Option A — Formspree (form endpoint ID, e.g. "abcdwxyz")
FORMSPREE_FORM_ID=
# Option B — Resend (server-side API key + verified sender + destination inbox)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Optional GitHub token used only by `npm run snapshot:github` to raise the API
# rate limit. Never exposed to the browser.
GITHUB_TOKEN=
