# All variables are optional. The site works fully without them.

# Canonical origin used for metadata, sitemap and Open Graph URLs.
NEXT_PUBLIC_SITE_URL=https://shivam-os-tau.vercel.app

# Contact form delivery. Leave both unset and the form explains that delivery
# is not configured and offers the email address instead.
# Option A — Formspree (form endpoint ID, e.g. "abcdwxyz")
FORMSPREE_FORM_ID=
# Option B — Resend (server-side API key + verified sender + destination inbox)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Ask SHIVAM.OS (AI answers grounded in the portfolio), using Google Gemini.
# Leave unset and the app says it is switched off. Server-only: never prefix
# with NEXT_PUBLIC_. Get a key at https://aistudio.google.com
GEMINI_API_KEY=
# Set to true only if billing is enabled on the key's Google Cloud project
# (free-tier inputs may be used by Google to improve its products).
GEMINI_PAID_TIER=
# Optional: model override (default gemini-3.6-flash).
ASK_MODEL=
# Optional: questions per server instance per day (default 400).
ASK_DAILY_LIMIT=

# Optional GitHub token used only by `npm run snapshot:github` to raise the API
# rate limit. Never exposed to the browser.
GITHUB_TOKEN=
